DISCORD_TOKEN=put_discord_bot_token_here
DISCORD_CLIENT_ID=put_discord_application_client_id_here
DISCORD_GUILD_ID=put_your_server_id_here

FACEIT_API_KEY=put_faceit_api_key_here

# Comma-separated FACEIT sources.
# Format: type:id:display name
FACEIT_SOURCES=championship:db2dfb5f-0569-40bd-b489-84bb759e72ed:Crossfire Season 7 - Group Stage

# Optional single staff role that can see every match channel.
DISCORD_STAFF_ROLE_ID=
# Exact roles that can see every match channel. Use this for Tournament Ops and Producer.
MATCH_ACCESS_ROLE_IDS=
# Roles that can set match schedules directly without both teams accepting.
SCHEDULE_OVERRIDE_ROLE_IDS=1128907825167482900
# Exact role IDs allowed to use staff commands/buttons in every configured server.
AUTHORIZED_STAFF_ROLE_IDS=
ADMIN_SCHEDULE_CHANNEL_ID=
CALL_ADMIN_CHANNEL_ID=
ADMIN_ALERT_ROLE_IDS=
MATCH_ACCESS_ROLE_NAMES=

# Optional two-way role mirroring between servers.
# Format: ROLE_SYNC_PAIRS=source_guild_id:source_role_id=target_guild_id:target_role_id;another_pair=...
ROLE_SYNC_PAIRS=1128905368018354277:1128907940720562296=1473173377005912074:1474117290600562920

# If true, missing Discord roles will be created using the FACEIT team names.
CREATE_MISSING_TEAM_ROLES=true
# For a new season, force a brand-new team role when that team has no mapping in
# the current TEAM_MAPPING_SEASON_ID. Existing same-name roles are not reused.
CREATE_NEW_SEASON_TEAM_ROLES=true
# Match channel sync uses the built-in Crossfire team role IDs first.
# Keep this false unless you intentionally want match sync to create missing team roles.
CREATE_MISSING_MATCH_TEAM_ROLES=false
# Optional overrides/additions for team role IDs.
# Format: TEAM_ROLE_IDS=FACEIT Team Name=role_id;Another Alias=role_id
TEAM_ROLE_IDS=

# Optional exact channel map for manually-created match rooms.
# Format: MATCH_CHANNEL_IDS=Team A|Team B=channel_id;Other A|Other B=channel_id
MATCH_CHANNEL_IDS=

# Optional exact category map for manually-created playoff round categories.
# Format: ROUND_CATEGORY_IDS=Upper Bracket - Round 1=1548120902154068039;Lower Bracket - Round 1=channel_category_id
ROUND_CATEGORY_IDS=

# Optional Google Sheet CSV export for team roles.
# Wide format is supported:
# Team Name, Starter #1 Discord ID, ..., Substitute #1 Discord ID, Coach Discord ID, Team Captain Discord ID
GOOGLE_SHEET_CSV_URL=
# Stable season/tournament scope used for persistent team mappings.
TEAM_MAPPING_SEASON_ID=crossfire-season-7-roles-v1
# Explicit FACEIT source IDs eligible for automatic playoff vetoes.
PLAYOFF_SOURCE_IDS=

ROSTER_TICKET_CHANNEL_ID=
SEASON_PARTICIPANT_ROLE_ID=1558620482574491708
SEASON_PARTICIPANT_ROLE_NAME=Season Participant
TEAM_CAPTAIN_ROLE_ID=
TEAM_CAPTAIN_ROLE_NAME=Team Captain
UPDATE_TEAM_NICKNAMES=true

# If your FACEIT account has a write scheduling endpoint, put it here.
# Leave blank until confirmed. The bot will still schedule in Discord.
FACEIT_SCHEDULE_ENDPOINT=

# Optional SCL 2D demo integration.
# SCL_API_KEY is issued by SCL and is not your FACEIT API key.
# SCL_WEBHOOK_SECRET is the shared HS256 webhook secret SCL gives you.
SCL_API_KEY=
SCL_WEBHOOK_SECRET=
SCL_WEBHOOK_PATH=/webhooks/scl

# Comma-separated ISO-like default timezones to show in schedule modals/messages.
DEFAULT_TIMEZONE=America/New_York

# Optional. Format:
# ROUND_WINDOWS=Upper Bracket - Round 1=2026-09-12..2026-09-14;Lower Bracket - Round 1=2026-09-15..2026-09-17
ROUND_WINDOWS=

# Playoff veto configuration. Exactly seven unique maps are required.
# Seeds must be actual tournament seeds supplied by staff; lower number is the higher seed.
VETO_MAP_POOL=
VETO_SEEDS=Team One=1;Team Two=2
VETO_CAPTAIN_ONLY=true
VETO_SIDE_POLICY=Staff decides sides after the Discord veto.
# Grand Final only: exact team name of the upper-bracket winner, or set per match with /cf veto action:seeds.
VETO_ADVANTAGE_TEAM=
VETO_STAFF_CHANNEL_ID=

# Community stream request workflow.
STREAM_REQUEST_CHANNEL_ID=
STREAM_STAFF_GUILD_ID=1473173377005912074
STREAM_STAFF_ROLE_IDS=1474118305169019163
STREAM_SCHEDULE_CHECK_MINUTES=20
STREAM_GUIDELINES_URL=
STREAM_GUIDELINES_TEXT=Follow all CROSSFIRE co-streaming rules and do not restream the official broadcast without explicit permission.
POST_CAST_FORM_URL=https://forms.gle/6zwVr2ArfFngGQ2NA
CROSSFIRE_RULES_URL=

# Optional persistent-volume path on Railway, for example /data/bot-data.json.
BOT_DATA_PATH=bot-data.json
