DISCORD_TOKEN=put_discord_bot_token_here
DISCORD_CLIENT_ID=put_discord_application_client_id_here
DISCORD_GUILD_ID=put_your_server_id_here

FACEIT_API_KEY=put_faceit_api_key_here

# Comma-separated FACEIT sources.
# Format: type:id:display name
FACEIT_SOURCES=championship:6b32f5c8-bcda-4f98-a9a5-f40bc2d4acbd:Crossfire Season 7 - Group Stage
# One-time repair mode: relink/move existing match channels only. It never creates channels.
REORGANIZE_EXISTING_MATCH_CHANNELS=false

# Optional single staff role that can see every match channel.
DISCORD_STAFF_ROLE_ID=
# Exact roles that can see every match channel. Use this for Tournament Ops and Producer.
MATCH_ACCESS_ROLE_IDS=
# Roles that can set match schedules directly without both teams accepting.
SCHEDULE_OVERRIDE_ROLE_IDS=1128907825167482900
# Exact role IDs allowed to use staff commands/buttons in every configured server.
AUTHORIZED_STAFF_ROLE_IDS=
# Tournament Operations: full access to every staff/admin action. Always merged into AUTHORIZED_STAFF_ROLE_IDS.
TOURNAMENT_OPS_ROLE_IDS=1474118305169019163
ADMIN_SCHEDULE_CHANNEL_ID=
CALL_ADMIN_CHANNEL_ID=
ADMIN_ALERT_ROLE_IDS=
MATCH_ACCESS_ROLE_NAMES=

# Optional two-way role mirroring between servers.
# Format: ROLE_SYNC_PAIRS=source_guild_id:source_role_id=target_guild_id:target_role_id;another_pair=...
ROLE_SYNC_PAIRS=1128905368018354277:1128907940720562296=1473173377005912074:1474117290600562920

# If true, missing Discord roles will be created using the FACEIT team names.
CREATE_MISSING_TEAM_ROLES=true
# For a new season, force a brand-new team role when that team has no mapping in
# the current TEAM_MAPPING_SEASON_ID. Existing same-name roles are not reused.
CREATE_NEW_SEASON_TEAM_ROLES=true
# Match channel sync uses the built-in Crossfire team role IDs first.
# Keep this false unless you intentionally want match sync to create missing team roles.
CREATE_MISSING_MATCH_TEAM_ROLES=false
# Optional overrides/additions for team role IDs.
# Format: TEAM_ROLE_IDS=FACEIT Team Name=role_id;Another Alias=role_id
TEAM_ROLE_IDS=

# Optional exact channel map for manually-created match rooms.
# Format: MATCH_CHANNEL_IDS=Team A|Team B=channel_id;Other A|Other B=channel_id
MATCH_CHANNEL_IDS=

# Optional exact category map for manually-created playoff round categories.
# Format: ROUND_CATEGORY_IDS=Upper Bracket - Round 1=1548120902154068039;Lower Bracket - Round 1=channel_category_id
ROUND_CATEGORY_IDS=

# Optional Google Sheet CSV export for team roles.
# Wide format is supported:
# Team Name, Starter #1 Discord ID, ..., Substitute #1 Discord ID, Coach Discord ID, Team Captain Discord ID
GOOGLE_SHEET_CSV_URL=
# Stable season/tournament scope used for persistent team mappings.
TEAM_MAPPING_SEASON_ID=crossfire-season-7-roles-v1
# Explicit FACEIT source IDs eligible for automatic playoff vetoes.
PLAYOFF_SOURCE_IDS=

ROSTER_TICKET_CHANNEL_ID=
SEASON_PARTICIPANT_ROLE_ID=1558620482574491708
SEASON_PARTICIPANT_ROLE_NAME=Season Participant
TEAM_CAPTAIN_ROLE_ID=
TEAM_CAPTAIN_ROLE_NAME=Team Captain
UPDATE_TEAM_NICKNAMES=true

# If your FACEIT account has a write scheduling endpoint, put it here.
# Leave blank until confirmed. The bot will still schedule in Discord.
FACEIT_SCHEDULE_ENDPOINT=

# Optional SCL 2D demo integration.
# SCL_API_KEY is issued by SCL and is not your FACEIT API key.
# SCL_WEBHOOK_SECRET is the shared HS256 webhook secret SCL gives you.
SCL_API_KEY=
SCL_WEBHOOK_SECRET=
SCL_WEBHOOK_PATH=/webhooks/scl

# Comma-separated ISO-like default timezones to show in schedule modals/messages.
DEFAULT_TIMEZONE=America/New_York

# Optional. Format:
# Group Stage uses each round range for match-room information, while scheduling is allowed across the full Group Stage range.
# Fallback only: round dates are normally set with /cf season action:rounds.
# ROUND_WINDOWS=Group Stage=2026-11-02..2026-11-11;Group Stage - Round 1=2026-11-02..2026-11-04;Group Stage - Round 2=2026-11-05..2026-11-07;Group Stage - Round 3=2026-11-08..2026-11-11
ROUND_WINDOWS=

# Playoff veto configuration. Exactly seven unique maps are required.
# Seeds must be actual tournament seeds supplied by staff; lower number is the higher seed.
VETO_MAP_POOL=
VETO_SEEDS=Team One=1;Team Two=2
VETO_CAPTAIN_ONLY=true
VETO_SIDE_POLICY=Staff decides sides after the Discord veto.
# Grand Final only: exact team name of the upper-bracket winner, or set per match with /cf veto action:seeds.
VETO_ADVANTAGE_TEAM=
VETO_STAFF_CHANNEL_ID=

# Community stream request workflow.
STREAM_REQUEST_CHANNEL_ID=
# Optional: channel that only ever shows currently-live community broadcasts (#live-now).
LIVE_NOW_CHANNEL_ID=
# Optional: #request-ip. Every IP staff enter is posted here, and the staff IP prompts move here
# from STREAM_REQUEST_CHANNEL_ID. Keep it private to staff and the production crew.
REQUEST_IP_CHANNEL_ID=
STREAM_STAFF_GUILD_ID=1473173377005912074
STREAM_STAFF_ROLE_IDS=1474118305169019163
STREAM_SCHEDULE_CHECK_MINUTES=20
STREAM_GUIDELINES_URL=
STREAM_GUIDELINES_TEXT=Follow all CROSSFIRE co-streaming rules and do not restream the official broadcast without explicit permission.
POST_CAST_FORM_URL=https://forms.gle/6zwVr2ArfFngGQ2NA
# Same form pre-filled per cast. {requestId}, {streamUrl}, {streamDate} (YYYY-MM-DD in
# DEFAULT_TIMEZONE) and {matchup} are replaced; a question with no known value is left blank.
# From the form editor: three-dot menu > Pre-fill form > Get link, then swap in the placeholders.
POST_CAST_FORM_PREFILL_URL=https://docs.google.com/forms/d/e/1FAIpQLSe32Ix7mieBvNJ4bZ4bajf4wmMCulwQVY02droPomaS2ssgQQ/viewform?usp=pp_url&entry.104948941={requestId}&entry.532463285={streamUrl}&entry.131165552={streamDate}&entry.286036985={matchup}
# Set to false to let casters request again before their last post-cast form is in.
POST_CAST_FORM_GATE=true
# Casts finished before this ISO time never block a caster.
POST_CAST_FORM_GATE_SINCE=2026-11-02T00:00:00Z
CROSSFIRE_RULES_URL=
# Optional: only accept `/request stream` and `!request` in these community channels.
STREAM_COMMUNITY_CHANNEL_IDS=
# Official CROSSFIRE stream channels staff pick from in `/cf mainstream` (first = default).
MAIN_STREAM_URLS=https://twitch.tv/playcrossfire,https://twitch.tv/playcrossfirecs,https://twitch.tv/playcrossfirecs2
# Where the main stream production schedule post goes. Defaults to the Schedule channel.
PRODUCTION_SCHEDULE_CHANNEL_ID=1473807016643264522
# Daily Upcoming Matches post. Channel defaults to the community casters channel.
# The role is pinged (the bot needs permission to mention it).
OPEN_MATCHES_CHANNEL_ID=1444895003691319336
# Defaults to the Community Caster role.
COMMUNITY_CASTER_ROLE_ID=1565414651376705607
# Eastern time, 24-hour HH:MM. Default 17:00 (5 PM).
OPEN_MATCHES_POST_TIME=17:00
# Crew availability from the PROD SCHEDULE / Admin Schedule tabs (needs the sheet web app).
# off = disabled. Match length is how long a main stream match is assumed to run.
CREW_AVAILABILITY=
CREW_AVAILABILITY_SYNC_MINUTES=10
CREW_MATCH_LENGTH_MINUTES=180
# Optional: channel for crew alerts. Empty = DM whoever set the crew.
CREW_ALERTS_CHANNEL_ID=
# Sunday "fill in next week" reminder, Eastern 24-hour HH:MM.
CREW_REMINDER_TIME=18:00
AVAILABILITY_SHEET_URL=
# Caster prep packs for main stream matches (channel, minutes before) and the production role
# that may use /cf prep and /crossfire teamnotes.
PREP_CHANNEL_ID=1569447282716311584
PREP_LEAD_MINUTES=45
# Teams per group that go through to the playoffs (used for elimination / clinch lines).
GROUP_ADVANCE_COUNT=2
# Main stream post-cast forms: posted after each main stream match (and nudged after 48 hours or
# from /cf forms) in MAINSTREAM_FORM_CHANNEL_ID (#CommunityStreamRequest), pinging these Discord
# user IDs (Crown, BignTallMatt). Matches before MAINSTREAM_FORM_SINCE are skipped.
MAINSTREAM_FORM_CHANNEL_ID=1558684878743150693
MAINSTREAM_FORM_USER_IDS=252433882991820810,206446410042834945
MAINSTREAM_FORM_SINCE=2026-11-10T12:00:00Z
# /roster-change: the roster spreadsheet and tab (Crossfire Player Tracking > Roster Tracking), the channel admins are told in, and the
# roles pinged there (defaults to ADMIN_ALERT_ROLE_IDS). Written through the Apps Script.
ROSTER_SPREADSHEET_ID=1zgbcvzSqo3hxsH20PH51y2xrODODNnUfGMgLrJGinng
ROSTER_SHEET_NAME=Roster Tracking
ROSTER_CHANGE_CHANNEL_ID=1569823541858410507
ROSTER_CHANGE_PING_ROLE_IDS=
# Text shown for the Twitter / FACEIT / HLTV hyperlinks written to the roster tab.
ROSTER_LINK_LABEL=…
# Streaming Application form: new responses are posted in this channel pinging these user IDs
# (checked every 5 minutes through the Apps Script "casterApplications" action).
CASTER_APPLICATION_CHANNEL_ID=1558684878743150693
CASTER_APPLICATION_PING_IDS=206446410042834945
CASTER_APPLICATION_SHEET_URL=https://docs.google.com/spreadsheets/d/1rQGdrdrrbh94ZR_EL12uCqcQwHR6A4VR9SBDbjXGJZY/edit?gid=37125937#gid=37125937
# #FireCrown: every mention gets a 🔥 reaction; the bot posts #FireCrown at most once per this many seconds per channel (0 = every time).
FIRECROWN_COOLDOWN_SECONDS=60
PROD_ROLE_ID=1474117290600562920
# Social info for the Social Media team (facts, not finished posts): channel, daily/weekly post
# time (Eastern, 24-hour) and how long before a main stream match its card goes up.
SOCIAL_CHANNEL_ID=1473806928865005802
SOCIAL_POST_TIME=16:00
SOCIAL_CARD_LEAD_MINUTES=120
# Optional: restrict accepted stream platforms (twitch, youtube, kick). Empty = all three.
STREAM_ALLOWED_PLATFORMS=

# Website publishing for approved streams. Leave WEBSITE_ENDPOINT empty for
# log-only mode: approvals succeed and the payload is printed to the log.
# See README "Website contract" for the JSON the site receives.
WEBSITE_ENDPOINT=
# Preferred key name for the CrossfireGG API. WEBSITE_API_KEY remains supported.
CROSSFIREBOT_API_KEY=
WEBSITE_API_KEY=
WEBSITE_TIMEOUT_SECONDS=10
WEBSITE_MAX_ATTEMPTS=3

# Google Sheet schedule log. Deploy docs/schedule-log-apps-script.gs as a web app
# and paste its /exec URL here. Leave empty to only log schedules to the console.
SCHEDULE_SHEET_WEBHOOK_URL=
# Must match SHARED_SECRET inside the Apps Script.
SCHEDULE_SHEET_SECRET=
SCHEDULE_SHEET_TIMEOUT_SECONDS=45

# Optional persistent-volume path on Railway, for example /data/bot-data.json.
BOT_DATA_PATH=bot-data.json
